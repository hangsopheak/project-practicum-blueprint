# Database Configuration (Docker PostgreSQL)
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=jobmatch_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@localhost:5432/jobmatch_db

# Security & JWT Authentication (Generate a strong secret key for production)
SECRET_KEY=change_me_to_a_secure_random_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email & OTP Settings (Optional for live SMTP sending, default logs to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_ENABLED=false

# TypeSafe AI Jev — Job Classification Engine
# Get your API key at: https://typesafe.ai
# Leave empty to disable Jev and use Python rule-based fallback only
JEV_API_KEY=
JEV_CONFIDENCE_THRESHOLD=0.65
